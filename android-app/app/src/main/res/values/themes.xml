<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MobileDataMonitor" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Status bar and navigation -->
        <item name="android:statusBarColor">@color/void_black</item>
        <item name="android:navigationBarColor">@color/void_black</item>
        <item name="android:windowBackground">@color/void_black</item>
        
        <!-- Primary colors -->
        <item name="colorPrimary">@color/cyber_400</item>
        <item name="colorPrimaryDark">@color/cyber_600</item>
        <item name="colorAccent">@color/pulse_green</item>
        
        <!-- Text colors -->
        <item name="android:textColor">@color/ghost_white</item>
        <item name="android:textColorPrimary">@color/ghost_white</item>
        <item name="android:textColorSecondary">@color/mist_gray</item>
        <item name="android:textColorHint">@color/steel_gray</item>
        
        <!-- Button styling -->
        <item name="android:buttonStyle">@style/Widget.MonitorDados.Button</item>
        
        <!-- EditText styling -->
        <item name="android:editTextStyle">@style/Widget.MonitorDados.EditText</item>
        
        <!-- Divider -->
        <item name="android:listDivider">@color/cyber_400_10</item>
    </style>
    
    <!-- Base TextAppearance.MonitorDados style -->
    <style name="TextAppearance.MonitorDados" parent="android:TextAppearance">
        <item name="android:textColor">@color/ghost_white</item>
    </style>
    
    <!-- Base Widget.MonitorDados style -->
    <style name="Widget.MonitorDados" parent="android:Widget">
    </style>
    
    <!-- Custom Button Style -->
    <style name="Widget.MonitorDados.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/void_black</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.02</item>
    </style>
    
    <!-- Custom EditText Style -->
    <style name="Widget.MonitorDados.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:textColor">@color/ghost_white</item>
        <item name="android:textColorHint">@color/steel_gray</item>
        <item name="android:padding">16dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    
    <!-- Card Style -->
    <style name="Widget.MonitorDados.Card">
        <item name="android:background">@drawable/bg_surface_card</item>
        <item name="android:padding">20dp</item>
    </style>
    
    <!-- Section Title Style -->
    <style name="TextAppearance.MonitorDados.Title">
        <item name="android:textColor">@color/ghost_white</item>
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    
    <!-- Subtitle Style -->
    <style name="TextAppearance.MonitorDados.Subtitle">
        <item name="android:textColor">@color/mist_gray</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>
    
    <!-- Label Style -->
    <style name="TextAppearance.MonitorDados.Label">
        <item name="android:textColor">@color/steel_gray</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
