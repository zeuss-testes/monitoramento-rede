<?xml version="1.0" encoding="utf-8"?>
<!-- Primary button matching dashboard's btn-glow with gradient from cyber to pulse -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4000D4FF">
    
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    
    <item>
        <shape android:shape="rectangle">
            <!-- Gradient matching dashboard's from-cyber-400 to-cyber-500 -->
            <gradient
                android:startColor="#00D4FF"
                android:endColor="#00B8DB"
                android:angle="90"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</ripple>
