<?xml version="1.0" encoding="utf-8"?>
<!-- Input field matching dashboard's input styling -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused state - matching dashboard's focus:border-cyber-400 focus:ring-cyber-400/30 -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#0F1628" />
            <stroke
                android:width="1.5dp"
                android:color="#00D4FF" />
            <corners android:radius="12dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>
    
    <!-- Default state - matching dashboard's border-cyber-400/20 bg-space/80 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0F1628" />
            <stroke
                android:width="1dp"
                android:color="#3300D4FF" />
            <corners android:radius="12dp" />
            <padding
                android:left="16dp"
                android:top="14dp"
                android:right="16dp"
                android:bottom="14dp" />
        </shape>
    </item>
    
</selector>
