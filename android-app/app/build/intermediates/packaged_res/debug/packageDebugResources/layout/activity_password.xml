<?xml version="1.0" encoding="utf-8"?>
<!-- Password screen matching dashboard's login/card styling -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Main Card - matching dashboard's glass-card glow-border -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:orientation="vertical"
        android:padding="32dp"
        android:background="@drawable/bg_surface_card"
        android:elevation="4dp">

        <!-- Logo Icon Container - matching dashboard's icon boxes -->
        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_icon_container">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_view"
                android:tint="@color/cyber_400" />
        </FrameLayout>

        <!-- Brand Title - matching dashboard's font-display text-2xl font-bold -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Monitor de Dados"
            android:textColor="@color/ghost_white"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center" />

        <!-- Subtitle - matching dashboard's text-mist text-[10px] uppercase -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="PAINEL DE CONTROLE"
            android:textColor="@color/mist_gray"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.25"
            android:gravity="center" />

        <!-- Divider - matching dashboard's border-t border-cyber-400/10 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="28dp"
            android:background="@color/cyber_400_10" />

        <!-- Instructions - matching dashboard's text-mist text-sm -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Digite sua senha para acessar"
            android:textColor="@color/mist_gray"
            android:textSize="14sp"
            android:gravity="center" />

        <!-- Password Input Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical">

            <!-- Label - matching dashboard's text-[10px] uppercase tracking-[0.25em] text-steel -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SENHA"
                android:textColor="@color/steel_gray"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.2"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <!-- Input Field - matching dashboard's rounded-xl border-cyber-400/20 -->
            <EditText
                android:id="@+id/password_input"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:inputType="textPassword"
                android:hint="••••••••"
                android:importantForAutofill="no"
                android:maxLines="1"
                android:background="@drawable/bg_input_field"
                android:textColor="@color/ghost_white"
                android:textColorHint="@color/steel_gray"
                android:textSize="16sp"
                android:fontFamily="monospace"
                android:gravity="center" />

        </LinearLayout>
        
        <!-- Submit Button - matching dashboard's Button primary variant -->
        <Button
            android:id="@+id/submit_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:text="Entrar"
            android:textAllCaps="false"
            android:textColor="@color/void_black"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.02"
            android:background="@drawable/bg_button_primary" />

        <!-- Status Indicator - matching dashboard's pulse indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Pulse dot -->
            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_status_dot_pulse" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Sistema Online"
                android:textColor="@color/pulse_green"
                android:textSize="10sp"
                android:textAllCaps="true"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
