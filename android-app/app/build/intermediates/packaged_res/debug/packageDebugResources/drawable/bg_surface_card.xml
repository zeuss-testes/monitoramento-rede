<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card effect matching dashboard's glass-card class -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base dark fill with gradient matching dashboard -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#CC0F1628"
                android:centerColor="#990F1628"
                android:endColor="#B3151D35"
                android:angle="135"
                android:type="linear" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
    <!-- Border with gradient from cyan to green (matching glow-border) -->
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#1A00D4FF" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    
</layer-list>
